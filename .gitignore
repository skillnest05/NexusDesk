# ==============================
# NexusDesk .gitignore
# ==============================

# Environment Variables (CRITICAL — contains passwords & API keys)
.env
!.env.example

# Logs
*.log
error_log

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editor Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# User Uploads (keep directory structure)
uploads/*
!uploads/.gitkeep

# Temporary / Build Files
phpmailer.zip
*.tmp
*.bak

# Agents directory
.agents/

# README backup
README.md~
